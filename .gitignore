Thumbs.db

# Build files
server/_core/build-info.json
*.tgz
*.tar.gz
.cache/
dist/
# 調査用に出した Expo web ビルド（dist-map / dist-perf / dist-pl …）。
# 1つ 60〜85MB あり、放置すると git status が常に汚れて
# `git add -A` で巻き込む事故の元になる（過去に .npm-cache で実際に踏んだ）。
dist-*/

# 会議ハーネスの作業ディレクトリ・頂いた参照ソース（ビルド対象外）
council/

.vercel
.env*.local
.env.vercel.tmp

# Playwright E2E
.auth/
playwright-report/
test-results/

# 認証済みホーム ソークテスト出力 (scripts/auth-home-soak.mjs)
soak-results/

# 初回ロードOOMプローブ出力 (scripts/first-load-crash.mjs)
qa-results/

.vercel
.env*.local

# LP画像の試作・元写真バックアップ(本番不要・誤コミット防止)
public/lp/img/_sumi-test/
public/lp/img/_orig-photo/

# LP幻燈動画の録画中間物(webm/frames・本番不要)
.tmp-lp-video-raw/
.tmp-lp-video-frames/

# ストア申請用の鍵置き場（絶対にコミットしない）
.secrets-local/

# パッケージマネージャのローカルキャッシュ。
# 未登録だと `git add -A` が数万ファイルを巻き込み、commit が数分かかって
# タイムアウトする（2026-08-15 に実際に踏んだ）。
.npm-cache/
.pnpm-store/
.tmp-responsive-audit.json

# 計器の生成物（キットの .gitignore と同じ方針）
# ★.instrument-context.md は毎回再生成される5000行超の索引。追跡しない。
# ★.instrument-ran.json も追跡しない（2026-08-29・CI を実際に落としてから判明）。
#   中身は「どのコミットで計器が緑になったか」の記録だが、検証は git cat-file で
#   そのSHAを解決する。★CI は shallow clone なので手元のSHAが存在せず、
#   『記録のコミットがこのリポに見つかりません』で exit 2 になる。
#   ＝ これは共有する記録ではなく**マシンごとのローカル状態**。追跡が誤りだった。
.instrument-context.md
.instrument-report.json
.instrument-ran.json
